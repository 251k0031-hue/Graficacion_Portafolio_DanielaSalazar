function setup() {
  createCanvas(800, 600);
  noLoop();
}

function draw() {

  // ==========================================
  // FONDO - PARED
  // ==========================================

  background("#7BA9C8");

  // Pared izquierda
  fill("#79A8C7");
  rect(0, 0, 430, 400);

  // Pared derecha
  fill("#6F9FC2");
  rect(430, 0, 370, 400);

  // ==========================================
  // PISO
  // ==========================================

  fill("#806044");
  rect(0, 400, 800, 200);

  // Líneas del piso
  stroke("#4F392C");
  strokeWeight(2);

  line(20, 400, 90, 600);
  line(80, 400, 140, 600);
  line(140, 400, 190, 600);
  line(200, 400, 245, 600);
  line(260, 400, 310, 600);
  line(320, 400, 375, 600);
  line(380, 400, 440, 600);
  line(440, 400, 510, 600);
  line(500, 400, 580, 600);
  line(560, 400, 650, 600);
  line(620, 400, 720, 600);
  line(680, 400, 790, 600);

  // ==========================================
  // VENTANA
  // ==========================================

  stroke("#263B25");
  strokeWeight(6);
  fill("#41622E");

  rect(120, 20, 180, 220);

  // Cristales verdes
  fill("#8AAE42");

  rect(135, 35, 65, 75);
  rect(215, 35, 65, 75);

  rect(135, 125, 65, 75);
  rect(215, 125, 65, 75);

  // Marcos
  stroke("#263B25");
  strokeWeight(5);

  line(207, 20, 207, 240);
  line(120, 118, 300, 118);

  // ==========================================
  // CUADRO DE LA PARED
  // ==========================================

  stroke("#B87928");
  strokeWeight(6);
  fill("#D98B35");

  rect(335, 75, 120, 75);

  // Interior del cuadro
  fill("#D79C91");
  rect(345, 85, 100, 55);

  // ==========================================
  // PUERTA
  // ==========================================

  stroke("#24496C");
  strokeWeight(6);
  fill("#4380A7");

  rect(700, 0, 100, 520);

  // Paneles de la puerta
  fill("#4E88A9");

  rect(720, 25, 60, 110);
  rect(720, 155, 60, 100);
  rect(720, 275, 60, 150);

  // ==========================================
  // CUADROS PEQUEÑOS
  // ==========================================

  stroke("#C88629");
  strokeWeight(5);
  fill("#E4A04A");

  rect(520, 15, 65, 85);
  rect(610, 10, 65, 85);

  // Retratos
  fill("#B96E4C");
  ellipse(552, 52, 35, 45);
  ellipse(642, 48, 35, 45);

  // ==========================================
  // CAMA - ESTRUCTURA
  // ==========================================

  stroke("#8B4D16");
  strokeWeight(7);

  // Parte trasera
  fill("#C47A20");
  rect(365, 190, 280, 330);

  // Cabecera
  fill("#D38A27");
  rect(390, 175, 30, 340);

  // Parte frontal de la cama
  fill("#B86B1B");
  rect(560, 215, 85, 340);

  // Parte superior curva representada con elipse
  fill("#D88B25");
  ellipse(505, 220, 250, 70);

  // ==========================================
  // COLCHÓN
  // ==========================================

  stroke("#A96624");
  strokeWeight(5);

  fill("#E8D79D");
  rect(385, 210, 175, 130);

  // Almohadas
  fill("#F0E1A9");
  rect(405, 225, 75, 45);
  rect(485, 225, 65, 45);

  // Cobija roja
  fill("#9D2432");
  rect(475, 275, 70, 110);

  // ==========================================
  // MESA
  // ==========================================

  stroke("#713C1E");
  strokeWeight(5);

  fill("#A95F2A");
  rect(85, 270, 125, 70);

  // Patas de la mesa
  line(100, 340, 100, 420);
  line(195, 340, 195, 420);
  line(120, 340, 120, 420);
  line(175, 340, 175, 420);

  // ==========================================
  // OBJETOS SOBRE LA MESA
  // ==========================================

  fill("#496F8C");
  ellipse(125, 260, 55, 35);

  fill("#E5C35A");
  ellipse(160, 265, 45, 20);

  // ==========================================
  // SILLA 1
  // ==========================================

  stroke("#C29A24");
  strokeWeight(6);

  fill("#D4AE32");

  rect(245, 245, 35, 110);
  rect(225, 300, 75, 35);

  line(230, 335, 230, 420);
  line(290, 335, 290, 420);

  // Asiento
  fill("#7B7439");
  ellipse(260, 320, 70, 35);

  // ==========================================
  // SILLA 2
  // ==========================================

  stroke("#C29A24");
  strokeWeight(6);

  fill("#D2AA2C");

  rect(35, 330, 35, 110);
  rect(15, 385, 75, 35);

  line(20, 420, 20, 500);
  line(80, 420, 80, 500);

  fill("#77743B");
  ellipse(55, 405, 70, 35);

  // ==========================================
  // TELA / OBJETO COLGADO
  // ==========================================

  noStroke();
  fill("#D5C6A0");

  triangle(55, 100, 95, 80, 80, 300);
  triangle(55, 100, 35, 300, 80, 300);

  // ==========================================
  // DETALLES DECORATIVOS
  // ==========================================

  stroke("#D29A35");
  strokeWeight(4);

  // Cuadros de la pared
  fill("#D7B24D");
  rect(520, 120, 45, 55);
  rect(580, 115, 100, 50);

  // ==========================================
  // MARCOS Y BORDES
  // ==========================================

  stroke("#3D5D72");
  strokeWeight(3);

  line(0, 0, 0, 600);
  line(430, 0, 430, 400);
  line(700, 0, 700, 520);

  // ==========================================
  // ALGUNOS DETALLES FINALES
  // ==========================================

  stroke("#573A29");
  strokeWeight(3);

  // Líneas de la madera de la cama
  line(580, 250, 620, 245);
  line(580, 300, 625, 295);
  line(580, 350, 620, 345);
  line(580, 400, 625, 395);
  line(580, 450, 620, 445);
}
