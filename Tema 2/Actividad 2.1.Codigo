function setup() {
  createCanvas(650, 300);
  angleMode(DEGREES);
}

function draw() {
  background(240);

  // ETAPA 1: Cachorro recién nacido
  push();
  translate(60, 150);
  scale(0.45);
  rotate(-4);
  dibujarPerro(1);
  pop();

  // ETAPA 2: Cachorro pequeño
  push();
  translate(185, 150);
  scale(0.65);
  rotate(3);
  dibujarPerro(2);
  pop();

  // ETAPA 3: Perro joven
  push();
  translate(315, 150);
  scale(0.85);
  rotate(-2);
  dibujarPerro(3);
  pop();

  // ETAPA 4: Perro adulto
  push();
  translate(455, 150);
  scale(1.05);
  rotate(2);
  dibujarPerro(4);
  pop();

  // ETAPA 5: Perro adulto mayor
  push();
  translate(585, 150);
  scale(1.10);
  rotate(-2);
  dibujarPerro(5);
  pop();
}


// ======================================
// FUNCIÓN QUE DIBUJA AL PERRO
// ======================================

function dibujarPerro(etapa) {

  stroke(45);
  strokeWeight(5);

  // Color del perro según su etapa
  if (etapa == 1) {
    fill(220, 175, 120);
  }
  else if (etapa == 2) {
    fill(205, 155, 100);
  }
  else if (etapa == 3) {
    fill(190, 135, 85);
  }
  else if (etapa == 4) {
    fill(170, 115, 70);
  }
  else {
    fill(150, 100, 65);
  }

  // Orejas
  ellipse(-38, -35, 35, 55);
  ellipse(38, -35, 35, 55);

  // Cabeza
  ellipse(0, 0, 90, 80);

  // Hocico
  fill(245, 220, 185);
  ellipse(0, 18, 48, 35);

  // Ojos
  fill(35);
  ellipse(-18, -10, 10, 10);
  ellipse(18, -10, 10, 10);

  // Nariz
  fill(25);
  ellipse(0, 10, 15, 12);

  // Boca
  stroke(45);
  strokeWeight(3);
  line(0, 16, 0, 25);
  arc(-7, 25, 14, 10, 0, 180);
  arc(7, 25, 14, 10, 0, 180);


  // ======================================
  // CAMBIOS SEGÚN LA ETAPA DE VIDA
  // ======================================

  // ETAPA 1: Cachorro recién nacido
  if (etapa == 1) {

    // Manchita pequeña
    fill(130, 80, 45);
    ellipse(-25, 5, 10, 11);
  }


  // ETAPA 2: Cachorro pequeño
  if (etapa == 2) {

    // Manchita más grande
    fill(130, 80, 45);
    ellipse(-25, 5, 10, 12);

    // Collar
    fill(220, 40, 60);
    rectMode(CENTER);
    rect(0, 38, 45, 7);
  }


  // ETAPA 3: Perro joven
  if (etapa == 3) {

    // Collar azul
    fill(40, 100, 200);
    rectMode(CENTER);
    rect(0, 38, 48, 7);

    // Placa
    fill(220, 190, 40);
    ellipse(0, 47, 12, 12);
  }


  // ETAPA 4: Perro adulto
  if (etapa == 4) {

    // Collar verde
    fill(50, 150, 80);
    rectMode(CENTER);
    rect(0, 38, 50, 8);

    // Placa
    fill(230, 200, 50);
    ellipse(0, 48, 13, 13);
  }


  // ETAPA 5: Perro adulto mayor
  if (etapa == 5) {

    // Pelaje con algunas canas
    fill(220);
    ellipse(-28, -25, 9, 9);
    ellipse(28, -25, 9, 9);

    // Collar
    fill(100, 100, 100);
    rectMode(CENTER);
    rect(0, 38, 50, 8);

    // Placa
    fill(180);
    ellipse(0, 48, 13, 13);
  }
}
