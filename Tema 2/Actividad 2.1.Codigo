function setup() {
  createCanvas(600, 250);
  angleMode(DEGREES);
}

function draw() {
  background(240);

  // ETAPA 1: Oso bebé
  push();
  translate(55, 125);
  scale(0.45);
  rotate(-5);
  dibujarOso(1);
  pop();

  // ETAPA 2: Oso pequeño
  push();
  translate(170, 125);
  scale(0.65);
  rotate(4);
  dibujarOso(2);
  pop();

  // ETAPA 3: Oso juvenil
  push();
  translate(285, 125);
  scale(0.85);
  rotate(-3);
  dibujarOso(3);
  pop();

  // ETAPA 4: Oso adolescente
  push();
  translate(400, 125);
  scale(1.05);
  rotate(3);
  dibujarOso(4);
  pop();

  // ETAPA 5: Oso adulto
  push();
  translate(520, 125);
  scale(1.15);
  rotate(-2);
  dibujarOso(5);
  pop();
}



// FUNCIÓN QUE DIBUJA LA CABEZA DEL OSO

function dibujarOso(etapa) {

  stroke(45);
  strokeWeight(5);

  // Color del oso
  if (etapa == 1) {
    fill(210, 170, 125);
  } 
  else if (etapa == 2) {
    fill(190, 145, 100);
  } 
  else if (etapa == 3) {
    fill(165, 115, 75);
  } 
  else if (etapa == 4) {
    fill(140, 90, 55);
  } 
  else {
    fill(115, 70, 42);
  }

  // Orejas
  ellipse(-35, -38, 35, 35);
  ellipse(35, -38, 35, 35);

  // Interior de las orejas
  fill(235, 185, 155);
  ellipse(-35, -38, 18, 18);
  ellipse(35, -38, 18, 18);

  // Cabeza
  if (etapa == 1) {
    fill(210, 170, 125);
  } 
  else if (etapa == 2) {
    fill(190, 145, 100);
  } 
  else if (etapa == 3) {
    fill(165, 115, 75);
  } 
  else if (etapa == 4) {
    fill(140, 90, 55);
  } 
  else {
    fill(115, 70, 42);
  }

  ellipse(0, 0, 90, 80);

  // Ojos
  fill(35);
  ellipse(-18, -8, 9, 9);
  ellipse(18, -8, 9, 9);

  // Hocico
  fill(245, 220, 190);
  ellipse(0, 17, 45, 34);

  // Nariz
  fill(30);
  ellipse(0, 12, 14, 11);


  
  // CAMBIOS EN CADA ETAPA
  

  // ETAPA 1: Bebé
  if (etapa == 1) {
    fill(245, 150, 170);
    ellipse(0, 38, 18, 8);
  }


  // ETAPA 2: Moño
  if (etapa == 2) {
    fill(220, 40, 60);

    ellipse(-12, 45, 20, 16);
    ellipse(12, 45, 20, 16);
    ellipse(0, 45, 9, 9);
  }


  // ETAPA 3: GORRA CENTRADA
  if (etapa == 3) {

    fill(40, 100, 190);

     // Parte superior de la gorra
  ellipse(0, -48, 48, 20);

  // Rayita de la gorra
  rectMode(CENTER);
  rect(0, -41, 35, 7);
}


  // ETAPA 4: Cejas
  if (etapa == 4) {

    stroke(45);
    strokeWeight(5);

    line(-25, -20, -10, -23);
    line(10, -23, 25, -20);
  }


  // ETAPA 5: Cejas
  if (etapa == 5) {

    stroke(45);
    strokeWeight(6);

    line(-27, -21, -8, -25);
    line(8, -25, 27, -21);
  }
}
