function setup() {
  createCanvas(400, 400);

  // Color del fondo
  background(220);

  
  // Cabeza
  fill(255, 204, 0);

  // Borde negro
  stroke(0);

  // Grosor del borde
  strokeWeight(4);

  rect(100, 70, 200, 170);


  // Ojos
  fill(0, 150, 255);

  // Borde negro
  stroke(0);

  // Grosor del borde
  strokeWeight(4);

  ellipse(155, 125, 45, 45);
  ellipse(245, 125, 45, 45);


  //Boca
  fill(80, 80, 80);
  stroke(0);
  strokeWeight(4);

  rect(155, 175, 90, 30);


  // Antena
  stroke(0);
  strokeWeight(4);

  line(200, 70, 200, 35);


  
  // Parte Superior de la Antena
  
  fill(255, 80, 80);
  stroke(0);
  strokeWeight(2);

  ellipse(200, 25, 20, 20);


  // Cuerpo
  fill(120, 150, 180);
  stroke(0);
  strokeWeight(4);

  rect(125, 240, 150, 100);


  
  // Boton del cuerpo
  fill(255, 200, 50);
  stroke(0);
  strokeWeight(3);

  ellipse(200, 290, 35, 35);


  
  // Brazos
  stroke(0);
  strokeWeight(7);

  line(125, 260, 75, 310);
  line(275, 260, 325, 310);


  
  // Piernas
  stroke(0);
  strokeWeight(7);

  line(165, 340, 150, 380);
  line(235, 340, 250, 380);


  
  // Triangulo
  fill(255, 100, 100);
  stroke(0);
  strokeWeight(2);

  triangle(185, 215, 200, 195, 215, 215);


  
  // Figura transpa
 // Rojo con transparencia
  fill(255, 0, 0, 120);

  stroke(0);
  strokeWeight(2);

  ellipse(200, 150, 70, 40);
}


//¿Qué figura cambió de color y cuál mantuvo el color anterior?

//La figura que se dibujó después de cambiar la función fill() tomó el nuevo color rojo. La primera figura mantuvo el color que tenía anteriormente, porque las funciones de estilo afectan a las figuras que se dibujan después de ejecutarse.
